# 本地开发环境变量模板：复制为 .env 并按需修改。
# 所有值为占位符，仅用于本地开发，不得在真实环境中使用。

# PostgreSQL（docker-compose）
POSTGRES_USER=newsadmin
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=news_admin
POSTGRES_PORT=5432

# 后端
DATABASE_URL=postgres://newsadmin:change-me-in-dev@localhost:5432/news_admin?sslmode=disable
APP_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
ADMIN_INITIAL_PASSWORD=replace-before-seeding-admin

# 前端
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1